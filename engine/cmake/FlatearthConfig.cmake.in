# FlatearthConfig.cmake - CMake package config for Flatearth Engine SDK
# Generated by the build system

get_filename_component(_flattenarth_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

# Import the Flatearth targets
if(NOT TARGET flatearth::flatearth)
    add_library(flatearth::flatearth SHARED IMPORTED)

    # Find the library file (platform-specific)
    if(WIN32)
        set(_fe_lib "${_flattenarth_prefix}/bin/flatearth.dll")
        set(_fe_implib "${_flattenarth_prefix}/lib/flatearth.lib")
        if(EXISTS "${_fe_implib}")
            set_target_properties(flatearth::flatearth PROPERTIES
                IMPORTED_LOCATION "${_fe_lib}"
                IMPORTED_IMPLIB "${_fe_implib}"
            )
        endif()
    else()
        find_library(_fe_lib NAMES flatearth libflatearth.so PATHS "${_flattenarth_prefix}/lib" NO_DEFAULT_PATH)
        if(_fe_lib)
            set_target_properties(flatearth::flatearth PROPERTIES
                IMPORTED_LOCATION "${_fe_lib}"
            )
        endif()
    endif()

    set_target_properties(flatearth::flatearth PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_flattenarth_prefix}/include"
    )
endif()

# Provide both namespaced and non-namespaced targets
if(NOT TARGET flatearth)
    add_library(flatearth ALIAS flatearth::flatearth)
endif()
